            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(chatapp_db_pool_connections{db_system=~\"$db_system\",state=\"in_use\"})",
          "legendFormat": "__auto",
          "editorMode": "code",
          "instant": false,
          "range": true
