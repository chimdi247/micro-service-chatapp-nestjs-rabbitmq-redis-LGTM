            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(chatapp_http_server_requests{job=\"$service\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "instant": false,
          "range": true
