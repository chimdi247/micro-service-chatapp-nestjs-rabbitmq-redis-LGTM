{
  "uid": "chatapp-service-detail",
  "title": "ChatApp - Service drill-down (metrics, logs, traces)",
  "tags": [
    "chatapp",
    "service",
    "tracing",
    "logs"
  ],
  "description": "One service: RED metrics, runtime health, pools, service map, error/slow traces and correlated logs.",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(chatapp_http_server_requests, job)",
          "refId": "var-service"
        },
        "definition": "label_values(chatapp_http_server_requests, job)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        },
        "options": [],
        "regex": ""
      },
      {
        "type": "custom",
        "name": "level",
        "label": "Log level",
        "query": ".*,error,warn,info,debug",
        "current": {
          "selected": true,
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          },
          {
            "selected": false,
            "text": "error",
            "value": "error"
          },
          {
            "selected": false,
            "text": "warn",
            "value": "warn"
          },
          {
            "selected": false,
            "text": "info",
            "value": "info"
          },
          {
            "selected": false,
            "text": "debug",
            "value": "debug"
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Log text filter",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "ChatApp dashboards",
      "type": "dashboards",
      "tags": [
        "chatapp"
