# ============================================
# ChatApp Microservices - Environment Variables
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# A ready-to-use .env with generated dev secrets is already included in
# this repo so `docker compose up` works out of the box -- replace it
# (or edit it) before deploying anywhere real.
# ============================================

# General
NODE_ENV=production

# Must stay consistent with the *_DB_*/MONGO_INITDB_* credentials below.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://chatapp_mongo_user:testpassword@mongo:27017/chatapp_chat_service?authSource=admin
# Goes through PgBouncer (use user-db:5432 to bypass)
USER_DB_URL=postgres://chatapp_user:testpassword@pgbouncer:5432/chatapp_user_service
# Goes through ProxySQL (use auth-db:3306 to bypass)
AUTH_DB_URL=mysql://chatapp_auth_user:testpassword@proxysql:6033/chatapp_auth_service

# ============================================
# Security Secrets (REQUIRED - Generate secure values!)
# ============================================
# Generate with: openssl rand -base64 48
JWT_SECRET=asdfghjklasdfghjkasdfghjksdfghjksdfghjkwertyusdfghjasdfghsdfghjasdfg
JWT_REFRESH_SECRET=asdfghjklasdfghjkasdfghjksdfghjksdfghjkwertyusdfghjasdfghsdfghjasdfg
INTERNAL_API_TOKEN=asdfghjklasdfghjkasdfghjksdfghjksdfghjkwertyusdfghjasdfghsdfghjasdfg

# JWT Token Expiration
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# Service Ports (External - for host access)
# ============================================
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4003
USER_SERVICE_PORT=4001
CHAT_SERVICE_PORT=4002
CLIENT_PORT=3000

# ============================================
# RabbitMQ Configuration
# ============================================
# NOTE: the rabbitmq container's own login is hardcoded to guest/guest in
# docker-compose.yml (RABBITMQ_DEFAULT_USER/PASS), so RABBITMQ_URL above
# must keep using guest:guest. Management UI: http://localhost:15672
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379

# Redis Commander UI (visualize Redis keys): http://localhost:8081
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# ============================================
# MongoDB Configuration (Chat Service)
# ============================================
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=chatapp_mongo_user
MONGO_INITDB_ROOT_PASSWORD=testpassword

# ============================================
# PostgreSQL Configuration (User Service)
# ============================================
USER_DB_PORT=5432
USER_DB_NAME=chatapp_user_service
USER_DB_USER=chatapp_user
USER_DB_PASSWORD=testpassword

# ============================================
# MySQL Configuration (Auth Service)
# ============================================
AUTH_DB_PORT=3306
AUTH_DB_NAME=chatapp_auth_service
AUTH_DB_USER=chatapp_auth_user
AUTH_DB_PASSWORD=testpassword
AUTH_DB_ROOT_PASSWORD=root_password

# ============================================
# Dokploy Deployment Notes
# ============================================
# 1. In Dokploy, create a new "Compose" project
# 2. Point to your repository containing this docker-compose.yml
# 3. Set these environment variables in Dokploy's UI
# 4. Expose the gateway-service port (4000) and client port (3000) via
#    Dokploy's domain settings
#
# For production, ensure you:
# - Generate strong random secrets for JWT_SECRET, JWT_REFRESH_SECRET, INTERNAL_API_TOKEN
# - Use strong passwords for all database credentials
# - Configure proper SSL/TLS via Dokploy's proxy settings
# ============================================

# ============================================
# Connection pools
# ============================================
AUTH_DB_POOL_MAX=10
USER_DB_POOL_MAX=10
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000

# PostgreSQL streaming replication (user-db -> user-db-replica)
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_password
# Must match docker/init-db/auth-mysql/03-monitoring.sql
MYSQL_EXPORTER_PASSWORD=exporter_password

# ============================================
# Observability (see observability/README.md)
# ============================================
DEPLOYMENT_ENVIRONMENT=local
LOG_LEVEL=info
# 1.0 = keep every trace. Lower (e.g. 0.1) for high-traffic environments.

OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# Grafana UI: http://localhost:3001
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# S3 bucket storage for Mimir / Loki / Tempo. Defaults = bundled MinIO
# (console: http://localhost:9001). To use AWS S3 instead, see observability/README.md.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=minio:9000
S3_REGION=us-east-1
S3_INSECURE=true
MIMIR_BLOCKS_BUCKET=mimir-blocks
MIMIR_RULER_BUCKET=mimir-ruler
MIMIR_ALERTMANAGER_BUCKET=mimir-alertmanager
LOKI_BUCKET=loki-chunks
TEMPO_BUCKET=tempo-traces

# Alert emails (Grafana-managed alerts). Default SMTP = bundled Mailpit
# (inbox: http://localhost:8025). For real delivery point these at your provider.
ALERT_EMAIL_TO=shimdi247@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=grafana-alerts@chatapp.com
SMTP_FROM_NAME=ChatApp Alerts
SMTP_SKIP_VERIFY=true
SMTP_STARTTLS_POLICY=MandatoryStartTLS
