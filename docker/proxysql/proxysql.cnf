# ProxySQL in front of auth-db (MySQL). auth-service connects to :6033.
# Multiplexes many client connections onto a small pool of backend connections.
# Prometheus metrics: http://proxysql:6070/metrics (restapi).
datadir="/var/lib/proxysql"
errorlog="/var/lib/proxysql/proxysql.log"

admin_variables=
{
    admin_credentials="admin:admin;radmin:radmin"
    mysql_ifaces="0.0.0.0:6032"
    restapi_enabled=true
    restapi_port=6070
    prometheus_memory_metrics_interval=61
}

mysql_variables=
{
    threads=4
    max_connections=2048
    interfaces="0.0.0.0:6033"
    default_schema="information_schema"
    server_version="8.0.36"
    poll_timeout=2000
    stacksize=1048576
    connect_timeout_server=3000
    monitor_username="proxysql_monitor"
    monitor_password="monitor_password"
    monitor_history=600000
    monitor_connect_interval=60000
    monitor_ping_interval=10000
    ping_interval_server_msec=120000
    ping_timeout_server=500
    commands_stats=true
    sessions_sort=true
    connect_retries_on_failure=10
}

mysql_servers =
(
    { address="auth-db", port=3306, hostgroup=0, max_connections=100, max_replication_lag=10 }
)

mysql_users =
(
    {
        username="chatapp_auth_user"
        password="chatapp_auth_password"
        default_hostgroup=0
        default_schema="chatapp_auth_service"
        max_connections=500
        active=1
        transaction_persistent=1
    }
)
